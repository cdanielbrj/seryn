# Default: access only from this host at http://localhost:8080.
# Initial provisioning only. Existing SQLite credentials are never overwritten.
SERYN_ADMIN_USER=admin
# Set a unique password with 16–128 characters before the first start. No default password.
# Single-quote the value if it contains $, # or spaces (Compose .env syntax).
SERYN_ADMIN_PASSWORD=
# Optional alternative: path INSIDE the container; mount the secret file read-only.
# Leave SERYN_ADMIN_PASSWORD empty when using this option.
SERYN_ADMIN_PASSWORD_FILE=
SERYN_BIND_ADDRESS=127.0.0.1
SERYN_PORT=8080
SERYN_ALLOWED_HOSTS=localhost;127.0.0.1
SERYN_REQUIRE_HTTPS=false
# For remote access, use HTTPS and the exact IP of your trusted reverse proxy.
SERYN_TRUSTED_PROXY=127.0.0.1
